# ==============================================================================
# Chatto Bot — Environment Configuration Template
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development

# Allowed Origins for CORS (Comma-separated in Production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Persistence (Defaults to in-memory if empty)
# Example: DATABASE_PATH=./data/chatto_bot.db
DATABASE_PATH=

# Security & Master API Token
MASTER_API_TOKEN=chatto_dev_master_secret_key_change_in_prod

# LINE Messaging API Credentials (Global Fallback / Demo)
LINE_CHANNEL_SECRET=the_hill_land_line_secret_demo
LINE_CHANNEL_ACCESS_TOKEN=mock_line_token_the_hill_land

# Facebook Graph & Messenger API Credentials (Global Fallback / Demo)
FACEBOOK_APP_SECRET=the_hill_land_fb_secret_demo
FACEBOOK_VERIFY_TOKEN=the_hill_land_fb_verify_demo
FACEBOOK_PAGE_ACCESS_TOKEN=mock_fb_page_token_the_hill_land

# LLM Providers (For Future Integration Phase)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
