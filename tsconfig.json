{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["packages/core/src/*"],
      "@agent-runtime/*": ["packages/agent-runtime/src/*"],
      "@channel-adapters/*": ["packages/channel-adapters/src/*"],
      "@crm/*": ["packages/crm/src/*"],
      "@operations/*": ["packages/operations/src/*"],
      "@audit-analytics/*": ["packages/audit-analytics/src/*"],
      "@vertical-packs/*": ["packages/vertical-packs/*"]
    }
  },
  "include": [
    "packages/**/*",
    "apps/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
